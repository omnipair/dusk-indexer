# Dusk devnet ingestion daemon.
#
# Builds only the dusk-indexer-daemon binary and ships it with psql so the
# entrypoint can apply the dusk_ingestion migrations before starting. The
# pinned protocol artifacts under protocol/ are compiled into the binary and
# byte-verified at startup — a build from the wrong revision refuses to run.

FROM rustlang/rust:nightly-bookworm AS builder

RUN apt-get update && apt-get install -y \
  build-essential \
  pkg-config \
  libssl-dev \
  perl \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
RUN cargo build --release -p dusk-indexer-daemon

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
  ca-certificates \
  postgresql-client \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/dusk-indexer-daemon /usr/local/bin/dusk-indexer-daemon
COPY database/migrations/018_dusk_ingestion_foundation.sql /app/migrations/018_dusk_ingestion_foundation.sql
COPY database/migrations/019_dusk_event_stream.sql /app/migrations/019_dusk_event_stream.sql
COPY scripts/dusk-indexer-entrypoint.sh /usr/local/bin/dusk-indexer-entrypoint.sh
RUN chmod +x /usr/local/bin/dusk-indexer-entrypoint.sh

ENV RUST_LOG=info,sqlx=warn
ENTRYPOINT ["/usr/local/bin/dusk-indexer-entrypoint.sh"]
