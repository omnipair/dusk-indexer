# Required: the chain namespace is part of every event key and cursor.
DUSK_CLUSTER=devnet

# These defaults are compiled into dusk-indexer-foundation. Setting them
# explicitly is recommended in Railway so configuration drift fails at startup.
DUSK_PROGRAM_ID=5EuU8artxWthfER6GTUY52TfL1aRsQH2TH8DsdGCa8cJ
DUSK_IDL_HASH=efe3e2e4966172feaff7aa19795be103f02f133250efdcdd18e76364d4155966
DUSK_PROTOCOL_REVISION=devnet-2026-11-01-tranches-fresh

# Optional: post to Discord when the stream stalls and when it recovers. The
# webhook URL is a credential; set it as a Railway variable, never in git.
# The daemon sends at most one message per change, plus an hourly reminder.
# DUSK_ALERT_DISCORD_WEBHOOK=
# DUSK_ALERT_STALL_SECONDS=60
# DUSK_ALERT_REMIND_SECONDS=3600
