# Dockerfile.indexer .dockerignore
# Optimize build context for the indexer

# Rust build artifacts
target/
# Note: Cargo.lock is needed for reproducible builds

# Documentation and tests (not needed for production build)
**/*.md
**/tests/
**/fixtures/

# Development files
.env
.env.local
.env.development
.env.test

# Git and IDE files
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo
*~

# CI/CD files
.github/
.gitlab-ci.yml

# Node.js (not needed for Rust indexer)
node_modules/
package.json
package-lock.json
yarn.lock
bun.lock

# API and database components (separate services)
api/
# The dusk API image builds from api/; re-included after the exclusion so
# the last matching rule wins. Its build outputs stay out of every context.
!api/
api/node_modules/
api/dist/
database/
# The dusk daemon image carries its own migrations, applied by its entrypoint.
# Exceptions must follow the directory rule: the last matching rule wins.
!database/migrations/018_dusk_ingestion_foundation.sql
!database/migrations/019_dusk_event_stream.sql
!database/migrations/020_dusk_v1_compatibility.sql
!database/migrations/021_dusk_valuation_and_positions.sql
!database/migrations/022_dusk_retention.sql

# Other language artifacts
*.pyc
__pycache__/
.python-version

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Logs
*.log
logs/

# Editor backups
*.bak
*.backup

# Railway and deployment files (copied separately if needed)
railway.toml
docker-compose.yml
Dockerfile
!Dockerfile.indexer

# Test data and fixtures
**/fixtures/
test-data/

# Documentation
DEVELOPMENT.md
QUICKSTART.md
SETUP.md